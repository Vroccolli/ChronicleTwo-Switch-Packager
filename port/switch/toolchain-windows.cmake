# Native Windows CMake driver for the same devkitA64/libnx ABI. The upstream
# SDK CMake toolchain requires MSYS; no compiler/SDK files are modified here.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CT_SWITCH_PLATFORM TRUE CACHE INTERNAL "devkitA64/libnx target")
set(CT_DEVKITPRO "C:/devkitPro" CACHE PATH "Switch SDK root")
set(CMAKE_C_COMPILER "${CT_DEVKITPRO}/devkitA64/bin/aarch64-none-elf-gcc.exe")
set(CMAKE_CXX_COMPILER "${CT_DEVKITPRO}/devkitA64/bin/aarch64-none-elf-g++.exe")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_AR "${CT_DEVKITPRO}/devkitA64/bin/aarch64-none-elf-gcc-ar.exe")
set(CMAKE_RANLIB "${CT_DEVKITPRO}/devkitA64/bin/aarch64-none-elf-gcc-ranlib.exe")
set(CMAKE_FIND_ROOT_PATH "${CT_DEVKITPRO}/portlibs/switch" "${CT_DEVKITPRO}/libnx")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CT_SWITCH_FLAGS "-march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE -ffunction-sections -fdata-sections -D__SWITCH__ -I${CT_DEVKITPRO}/libnx/include -I${CT_DEVKITPRO}/portlibs/switch/include")
set(CMAKE_C_FLAGS_INIT "${CT_SWITCH_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${CT_SWITCH_FLAGS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${CT_DEVKITPRO}/libnx/lib -L${CT_DEVKITPRO}/portlibs/switch/lib -specs=${CT_DEVKITPRO}/libnx/switch.specs -Wl,--gc-sections")
set(CMAKE_C_STANDARD_LIBRARIES "-lnx -lm")
set(CMAKE_CXX_STANDARD_LIBRARIES "-lnx -lm")
